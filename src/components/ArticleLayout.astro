---
interface Heading {
  readonly depth: number;
  readonly slug: string;
  readonly text: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  updated: Date;
  author?: string;
  headings: readonly Heading[];
  backHref: string;
  backLabel: string;
  sectionLabel: string;
  drawerLabel?: string;
}

const {
  eyebrow,
  title,
  description,
  updated,
  author,
  headings,
  backHref,
  backLabel,
  sectionLabel,
  drawerLabel = "Documentation and contents",
} = Astro.props;

const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const updatedLabel = updated.toISOString().slice(0, 10);
const published = updated.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<article class="af-article af-container">
  <nav class="af-breadcrumb" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href={backHref}>{backLabel}</a></li>
      <li aria-current="page">{title}</li>
    </ol>
  </nav>

  <header class="af-article__head">
    <p class="af-eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="af-article__desc">{description}</p>
    <p class="af-article__meta">
      <span>{sectionLabel}</span>
      <span aria-hidden="true">·</span>
      <time datetime={updatedLabel}>Updated {published}</time>
      {author !== undefined && (
        <>
          <span aria-hidden="true">·</span>
          <span>{author}</span>
        </>
      )}
    </p>
  </header>

  <div class="af-article__layout">
    <details class="af-article__drawer" open>
      <summary>{drawerLabel}</summary>
      <div class="af-article__aside">
        <slot name="sidebar" />

        {
          toc.length > 0 && (
            <nav class="af-toc" aria-label="On this page">
              <p class="af-toc__label">On this page</p>
              <ol>
                {toc.map((heading) => (
                  <li class:list={[{ "af-toc__sub": heading.depth === 3 }]}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </div>
    </details>

    <div class="af-article__main">
      <div class="af-prose" data-prose>
        <slot />
      </div>
      <slot name="footer" />
    </div>
  </div>
</article>

<script>
  const drawerQuery = window.matchMedia("(max-width: 900px)");
  for (const drawer of document.querySelectorAll<HTMLDetailsElement>(".af-article__drawer")) {
    const sync = (): void => {
      drawer.open = !drawerQuery.matches;
    };
    sync();
    drawerQuery.addEventListener("change", sync);
  }

  for (const table of document.querySelectorAll<HTMLTableElement>("[data-prose] table")) {
    if (table.scrollWidth > table.clientWidth) {
      table.tabIndex = 0;
      table.setAttribute("role", "region");
      table.setAttribute("aria-label", "Scrollable table");
    }
  }

  for (const pre of document.querySelectorAll<HTMLPreElement>("[data-prose] pre")) {
    const code = pre.querySelector("code");
    if (code === null) continue;

    const button = document.createElement("button");
    button.type = "button";
    button.className = "af-copy-code";
    button.textContent = "Copy";

    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        button.textContent = "Copied";
        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1600);
      } catch {
        button.textContent = "Select";
        const range = document.createRange();
        range.selectNodeContents(code);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
    });

    pre.append(button);
  }
</script>

<style>
  .af-article {
    padding-block: 26px var(--af-section-y);
  }

  .af-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--af-muted);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .af-breadcrumb li + li::before {
    content: "/";
    margin-inline-end: 7px;
    color: var(--af-border-strong);
  }

  .af-breadcrumb a:hover {
    color: var(--af-accent);
  }

  .af-breadcrumb [aria-current="page"] {
    color: var(--af-accent);
    max-width: 46ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .af-article__head {
    max-width: 820px;
    margin-block-start: 22px;
  }

  .af-article__head h1 {
    margin: 6px 0 0;
    font-size: clamp(2rem, 4.4vw, 3rem);
    line-height: 1.05;
  }

  .af-article__desc {
    margin: 12px 0 0;
    color: var(--af-muted);
    font-size: 18px;
    line-height: 1.55;
  }

  .af-article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 14px 0 0;
    color: var(--af-muted);
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .af-article__layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    margin-block-start: 38px;
    align-items: start;
  }

  .af-article__aside {
    display: grid;
    gap: 18px;
  }

  .af-article__drawer {
    position: sticky;
    inset-block-start: 84px;
    min-width: 0;
  }

  .af-article__drawer > summary {
    display: none;
  }

  .af-toc {
    padding: 12px;
    background-color: var(--af-raised);
    border: 1px solid var(--af-border);
    border-radius: var(--af-radius);
  }

  .af-toc__label {
    margin: 2px 4px 8px;
    color: var(--af-accent);
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .af-toc ol {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .af-toc a {
    display: block;
    padding: 5px 7px;
    border-radius: 5px;
    color: var(--af-muted);
    font-size: 13px;
    line-height: 1.4;
  }

  .af-toc a:hover {
    background-color: color-mix(in srgb, var(--af-accent) 10%, transparent);
    color: var(--af-accent);
  }

  .af-toc__sub a {
    padding-inline-start: 17px;
    font-size: 12.5px;
  }

  @media (max-width: 900px) {
    .af-article__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .af-article__drawer {
      position: static;
      grid-row: 1;
    }

    .af-article__drawer > summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 11px 14px;
      background-color: var(--af-raised);
      border: 1px solid var(--af-border);
      border-radius: var(--af-radius);
      color: var(--af-text);
      font-family: var(--font-display);
      font-size: 15px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      cursor: pointer;
      list-style: none;
    }

    .af-article__drawer > summary::-webkit-details-marker {
      display: none;
    }

    .af-article__drawer > summary::after {
      content: "+";
      color: var(--af-accent);
      font-size: 18px;
    }

    .af-article__drawer[open] > summary {
      margin-block-end: 10px;
    }

    .af-article__drawer[open] > summary::after {
      content: "−";
    }

    .af-toc ol {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    }
  }
</style>
