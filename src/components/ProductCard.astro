---
import { existsSync } from "node:fs";
import { join } from "node:path";
import type { Product } from "@/data/products";
import { getCategory } from "@/data/categories";
import { getProductDetail } from "@/data/product-details";
import { getArtworkSize, getResponsiveSrcSet } from "@/data/artwork";
import { STORE_STATS, formatPrice } from "@/data/store-stats";

interface Props {
  product: Product;
  headingLevel?: "h2" | "h3";
}

const { product, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;

const category = getCategory(product.category);
const detail = getProductDetail(product);
const stat = STORE_STATS[product.slug];

// Every product has generated artwork. SMP products may live under products/smp/.
// Real art already set on the record is kept as-is.
const generatedDir = "/assets/img/products";
const image =
  product.image ??
  (existsSync(join(process.cwd(), "public", generatedDir, "smp", `${product.slug}.webp`))
    ? `${generatedDir}/smp/${product.slug}.webp`
    : `${generatedDir}/${product.slug}.webp`);
const size = getArtworkSize(product.slug);
const srcSet = getResponsiveSrcSet(image, size);
const isSquare = size !== undefined && size.width === size.height;

const href = `/plugins/${product.slug}/`;
const price = stat?.price !== undefined ? formatPrice(stat.price) : undefined;
const rating = stat?.rating !== undefined ? `★ ${stat.rating.toFixed(1)}` : undefined;
const ratingCount = stat?.ratings !== undefined ? `(${stat.ratings})` : undefined;
const sold =
  stat?.purchases !== undefined && stat.purchases > 0
    ? `${stat.purchases.toLocaleString("en-US")} sold`
    : undefined;
const platforms = (detail.compatibility?.platforms ?? []).slice(0, 2);
const hasStats = price !== undefined || rating !== undefined || sold !== undefined;
---

<li
  class="af-product-card"
  data-product={product.slug}
  data-name={product.name}
  data-summary={product.summary}
  data-tags={product.tags.join(" ")}
  data-category={product.category}
  data-featured={product.featured ? "1" : "0"}
  data-purchases={stat?.purchases ?? 0}
  data-revenue={Math.round((stat?.price ?? 0) * (stat?.purchases ?? 0))}
  data-rating={stat?.rating ?? 0}
  data-ratings={stat?.ratings ?? 0}
>
  <div class:list={["af-product-card__media", { "af-product-card__media--square": isSquare }]}>
    <img
      src={image}
      srcset={srcSet}
      sizes="(max-width: 620px) 78vw, (max-width: 820px) 45vw, (max-width: 1100px) 31vw, 300px"
      alt=""
      loading="lazy"
      decoding="async"
      width={size?.width}
      height={size?.height}
    />
  </div>

  <div class="af-product-card__body">
    {
      category !== undefined && <p class="af-product-card__category">{category.name}</p>
    }
    <Heading class="af-product-card__title">
      <a class="af-product-card__link" href={href}>{product.name}</a>
    </Heading>
    <p class="af-product-card__summary">{product.summary}</p>

    {
      hasStats && (
        <p class="af-product-card__stats">
          {price && <span class="af-product-card__price">{price}</span>}
          {rating && (
            <span>
              {rating}
              {ratingCount && <span> {ratingCount}</span>}
            </span>
          )}
          {sold && <span>{sold}</span>}
        </p>
      )
    }

    {
      platforms.length > 0 && (
        <ul class="af-product-card__platforms" aria-label="Platforms">
          {platforms.map((platform) => (
            <li>{platform}</li>
          ))}
        </ul>
      )
    }
  </div>
</li>

<script>
  // Whole card is a click target; real links inside keep their own behaviour.
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element) || event.defaultPrevented || event.button !== 0) return;
    const card = target.closest<HTMLElement>(".af-product-card");
    if (card === null || target.closest("a, button")) return;
    const link = card.querySelector<HTMLAnchorElement>(".af-product-card__link");
    if (link === null) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey) window.open(link.href, "_blank", "noopener");
    else window.location.assign(link.href);
  });
</script>

<style>
  .af-product-card {
    position: relative;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    background-color: var(--af-surface);
    border: 1px solid var(--af-border);
    border-radius: var(--af-radius);
    transition:
      border-color var(--af-transition),
      background-color var(--af-transition);
  }

  .af-product-card[hidden] {
    display: none !important;
  }

  .af-product-card:hover {
    border-color: var(--af-border-strong);
    background-color: var(--af-surface-2);
  }

  .af-product-card:has(.af-product-card__link:focus-visible) {
    outline: 2px solid var(--af-accent);
    outline-offset: 3px;
  }

  .af-product-card__media {
    flex: none;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--af-raised);
    border-block-end: 1px solid var(--af-border);
  }

  .af-product-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .af-product-card__media--square img {
    object-fit: contain;
    padding: 18px;
  }

  .af-product-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: 14px 16px 16px;
  }

  .af-product-card__category {
    margin: 0;
    color: var(--af-accent);
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .af-product-card__title {
    margin: 0;
    font-size: 20px;
    line-height: 1.2;
  }

  .af-product-card__link {
    color: var(--af-text);
    text-decoration: none;
  }

  /* Stretched link: the whole card is the tap and click target. */
  .af-product-card__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .af-product-card__link:focus-visible {
    outline: none;
  }

  .af-product-card:hover .af-product-card__link {
    color: var(--af-accent);
  }

  .af-product-card__summary {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--af-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .af-product-card__stats {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    margin: auto 0 0;
    padding-block-start: 6px;
    color: var(--af-muted);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .af-product-card__price {
    color: var(--af-text);
    font-weight: 600;
  }

  .af-product-card__platforms {
    display: flex;
    flex-wrap: nowrap;
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
  }

  .af-product-card__platforms li {
    min-width: 0;
    max-width: 50%;
    padding: 2px 9px;
    overflow: hidden;
    border: 1px solid var(--af-border-strong);
    border-radius: 999px;
    color: var(--af-muted);
    font-size: 12px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

</style>
