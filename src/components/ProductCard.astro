---
import type { Product } from "@/data/products";
import { getCategory } from "@/data/categories";
import { getProductDetail } from "@/data/product-details";
import { getArtworkSize, getResponsiveSrcSet } from "@/data/artwork";
import Icon from "@/components/Icon.astro";

interface Props {
  product: Product;
  headingLevel?: "h2" | "h3";
  variant?: "grid" | "rail";
}

const { product, headingLevel = "h3", variant = "grid" } = Astro.props;
const Heading = headingLevel;

const category = getCategory(product.category);
const detail = getProductDetail(product);
const size = getArtworkSize(product.slug);
const srcSet = product.image !== undefined ? getResponsiveSrcSet(product.image, size) : undefined;
const href = `/plugins/${product.slug}/`;
const hasImage = product.image !== undefined;
const isSquare = size !== undefined && size.width === size.height;
const platforms = detail.compatibility?.platforms?.slice(0, 3).join(" · ");
const metadata = platforms ?? product.tags[0];
const showIcon = !hasImage && product.icon !== undefined;
---

<li
  class:list={["af-product-card", `af-product-card--${variant}`]}
  data-product={product.slug}
  data-name={product.name}
  data-summary={product.summary}
  data-tags={product.tags.join(" ")}
  data-category={product.category}
  data-featured={product.featured ? "1" : "0"}
>
  <div class:list={["af-product-card__media", { "af-product-card__media--square": isSquare }]}>
    {
      hasImage ? (
        <img
          src={product.image}
          srcset={srcSet}
          sizes="(max-width: 620px) 78vw, (max-width: 820px) 45vw, (max-width: 1100px) 31vw, 300px"
          alt=""
          loading="lazy"
          decoding="async"
          width={size?.width}
          height={size?.height}
        />
      ) : (
        <div class="af-product-card__placeholder" aria-hidden="true">
          {showIcon && (
            <img
              class="af-product-card__placeholder-icon"
              src={product.icon}
              alt=""
              loading="lazy"
              decoding="async"
              width="48"
              height="48"
            />
          )}
          {category !== undefined && <Icon name={category.icon} size={30} />}
          <span>{category?.name ?? product.category}</span>
        </div>
      )
    }
  </div>

  <div class="af-product-card__body">
    <Heading class="af-product-card__title">
      <a href={href}>{product.name}</a>
    </Heading>

    <p class="af-product-card__summary">{product.summary}</p>

    <p class="af-product-card__meta">
      {
        category !== undefined ? (
          <a class="af-product-card__category" href={`/plugins/${product.category}/`}>
            {category.name}
          </a>
        ) : (
          <span class="af-product-card__category">{product.category}</span>
        )
      }
      {metadata && <span class="af-product-card__dot" aria-hidden="true">·</span>}
      {metadata && <span class="af-product-card__platform">{metadata}</span>}
    </p>
  </div>

  <a class="af-card-link" href={href}>
    View<span class="af-sr-only"> {product.name}</span>
    <span aria-hidden="true">→</span>
  </a>
</li>

<style>
  .af-product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    background-color: var(--af-surface);
    border: 1px solid var(--af-border);
    border-radius: var(--af-radius);
    transition:
      border-color var(--af-transition),
      background-color var(--af-transition),
      transform var(--af-transition);
  }

  .af-product-card[hidden] {
    display: none !important;
  }

  .af-product-card:hover {
    border-color: var(--af-border-strong);
    background-color: var(--af-surface-2);
    transform: translateY(-2px);
  }

  .af-product-card__media {
    position: relative;
    flex: none;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background:
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--af-primary) 22%, transparent), transparent 60%),
      var(--af-raised);
    border-block-end: 1px solid var(--af-border);
  }

  .af-product-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .af-product-card__media--square img {
    object-fit: contain;
    padding: 18px;
  }

  .af-product-card__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    width: 100%;
    height: 100%;
    padding: 18px;
    color: var(--af-muted);
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
  }

  .af-product-card__placeholder .af-icon {
    color: var(--af-accent);
  }

  .af-product-card__placeholder-icon {
    width: 48px;
    height: 48px;
    object-fit: contain;
    border-radius: 8px;
  }

  .af-product-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: 16px 18px 12px;
  }

  .af-product-card__title {
    font-size: 21px;
    line-height: 1.15;
  }

  .af-product-card__title a:hover {
    color: var(--af-accent);
  }

  .af-product-card__summary {
    display: -webkit-box;
    margin: 7px 0 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--af-muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .af-product-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: auto 0 0;
    padding-block-start: 12px;
    color: var(--af-muted);
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .af-product-card__category {
    color: var(--af-accent);
  }

  .af-product-card__category:hover {
    text-decoration: underline;
  }

  .af-product-card__dot {
    color: var(--af-border-strong);
  }

  .af-product-card__platform {
    color: var(--af-muted);
  }

  .af-card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    margin: 0 18px 16px;
    padding-block: 4px;
    color: var(--af-accent);
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .af-card-link:hover {
    text-decoration: underline;
  }

  .af-product-card--rail {
    min-width: 0;
  }

  .af-product-card--rail .af-product-card__title {
    font-size: 19px;
  }
</style>
