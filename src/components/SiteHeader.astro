---
import { SITE } from "../data/site";

interface Props {
  currentPath?: string;
}

const { currentPath } = Astro.props;

interface NavItem {
  readonly label: string;
  readonly href: string;
}

const NAV_ITEMS: readonly NavItem[] = [
  { label: "Plugins", href: "/plugins/" },
  { label: "Security", href: "/plugins/security/" },
  { label: "Performance", href: "/plugins/performance/" },
  { label: "Network", href: "/plugins/network/" },
  { label: "SMP", href: "/plugins/smp/" },
  { label: "About", href: "/about/" },
];

const NAV_HREFS: readonly string[] = NAV_ITEMS.map((item) => item.href);

function segmentsOf(path: string): string[] {
  return path.split("/").filter(Boolean);
}

/** Longest nav href whose leading path segments match, so /plugins/security/ never lights two items. */
function activeHref(path: string | undefined): string | undefined {
  if (path === undefined || path === "") return undefined;
  const current = segmentsOf(path);
  if (current.length === 0) return NAV_HREFS.includes("/") ? "/" : undefined;
  for (let depth = current.length; depth > 0; depth -= 1) {
    const candidate = `/${current.slice(0, depth).join("/")}/`;
    if (NAV_HREFS.includes(candidate)) return candidate;
  }
  return undefined;
}

const currentHref = activeHref(currentPath);
---

<header class="site-header">
  <div class="af-container header-inner">
    <a class="brand" href="/">
      <img
        src="/assets/img/arkflame-logo.webp"
        alt="ArkFlame Studios"
        width="28"
        height="28"
      />
      <span class="wordmark">ArkFlame Studios</span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul class="nav-list">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a href={item.href} aria-current={currentHref === item.href ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a class="github-link" href={SITE.githubUrl} target="_blank" rel="noopener noreferrer">
        <i class="bi bi-github" aria-hidden="true"></i>
        GitHub
      </a>
      <a class="btn btn-primary browse" href="/plugins/">Browse plugins</a>
    </div>

    <details class="mobile-menu">
      <summary aria-label="Menu">
        <span class="burger" aria-hidden="true"></span>
        Menu
      </summary>
      <div class="mobile-panel">
        <ul class="mobile-list">
          {
            NAV_ITEMS.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={currentHref === item.href ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer">
              <i class="bi bi-github" aria-hidden="true"></i>
              GitHub
            </a>
          </li>
        </ul>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 60;
    background-color: color-mix(in srgb, var(--af-bg) 78%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-block-end: 1px solid var(--af-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 62px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .brand img {
    width: 28px;
    height: 28px;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--af-text);
    white-space: nowrap;
  }

  .nav-desktop {
    margin-inline-start: auto;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list a {
    display: inline-block;
    padding: 7px 12px;
    border: 1px solid transparent;
    border-radius: var(--af-radius);
    color: var(--af-muted);
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color var(--af-transition), border-color var(--af-transition);
  }

  .nav-list a:hover {
    color: var(--af-text);
    border-color: color-mix(in srgb, var(--af-accent) 25%, transparent);
  }

  .nav-list a[aria-current="page"] {
    color: var(--af-text);
    border-color: color-mix(in srgb, var(--af-accent) 35%, transparent);
    background-color: color-mix(in srgb, var(--af-accent) 12%, transparent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-inline-start: auto;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 12px;
    border-radius: var(--af-radius);
    color: var(--af-muted);
    font-size: 15px;
    font-weight: 500;
    transition: color var(--af-transition);
  }

  .github-link:hover {
    color: var(--af-accent);
  }

  .browse {
    padding: 9px 18px;
    font-size: 14px;
  }

  .mobile-menu {
    display: none;
    margin-inline-start: auto;
    position: relative;
  }

  .mobile-menu summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--af-border-strong);
    border-radius: var(--af-radius);
    color: var(--af-text);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .burger {
    width: 16px;
    height: 2px;
    background-color: currentColor;
    box-shadow: 0 -5px 0 currentColor, 0 5px 0 currentColor;
  }

  .mobile-panel {
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: calc(100% + 10px);
    z-index: 70;
    min-width: 224px;
    padding: 10px;
    background-color: var(--af-surface);
    border: 1px solid var(--af-border);
    border-radius: var(--af-radius);
    box-shadow: 0 18px 40px color-mix(in srgb, var(--af-bg) 70%, transparent);
  }

  .mobile-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-list a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-radius: var(--af-radius);
    color: var(--af-text);
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: background-color var(--af-transition), color var(--af-transition);
  }

  .mobile-list a:hover {
    background-color: color-mix(in srgb, var(--af-accent) 12%, transparent);
    color: var(--af-accent);
  }

  .mobile-list a[aria-current="page"] {
    background-color: color-mix(in srgb, var(--af-accent) 12%, transparent);
    color: var(--af-accent);
  }

  @media (max-width: 940px) {
    .nav-desktop,
    .header-actions {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }
</style>