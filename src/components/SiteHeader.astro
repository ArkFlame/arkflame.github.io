---
import { SITE } from "../data/site";
import { CATEGORIES } from "../data/categories";
import Icon from "../components/Icon.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const isUnder = (prefix: string): boolean =>
  prefix === "/" ? currentPath === "/" : currentPath === prefix || currentPath.startsWith(prefix);

const pluginsActive = isUnder("/plugins");
const docsActive = isUnder("/docs");
const guidesActive = isUnder("/guides");
const aboutActive = isUnder("/about");

const primaryNav = [
  { label: "Docs", href: "/docs/", active: docsActive },
  { label: "Guides", href: "/guides/", active: guidesActive },
  { label: "About", href: "/about/", active: aboutActive },
] as const;
---

<header class="site-header">
  <div class="af-container header-inner">
    <a class="brand" href="/">
      <img src="/assets/img/arkflame-logo.webp" alt="" width="28" height="28" />
      <span class="wordmark">ArkFlame Studios</span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul class="nav-list">
        <li>
          <details class="nav-menu" data-nav-menu>
            <summary class:list={["nav-link", { "is-active": pluginsActive }]} aria-current={pluginsActive ? "page" : undefined}>
              Plugins
              <span class="nav-caret" aria-hidden="true">▾</span>
            </summary>
            <div class="nav-panel">
              <p class="nav-panel__label">Browse by category</p>
              <ul class="nav-panel__list">
                <li>
                  <a href="/plugins/" class="nav-panel__all">
                    <span>All plugins</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </li>
                {
                  CATEGORIES.map((category) => (
                    <li>
                      <a href={`/plugins/${category.slug}/`}>
                        <Icon name={category.icon} size={16} />
                        {category.name}
                      </a>
                    </li>
                  ))
                }
              </ul>
              <p class="nav-panel__note">51 plugins for Minecraft servers.</p>
            </div>
          </details>
        </li>
        {
          primaryNav.map((item) => (
            <li>
              <a class:list={["nav-link", { "is-active": item.active }]} href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a class="github-link" href={SITE.githubUrl} target="_blank" rel="noopener noreferrer" aria-label="ArkFlame on GitHub">
        <Icon name="github" size={16} />
        <span>GitHub</span>
      </a>
      <a class="btn btn-primary browse" href="/plugins/">Browse plugins</a>
    </div>

    <details class="mobile-menu" data-mobile-menu>
      <summary aria-label="Open menu">
        <span class="burger" aria-hidden="true"></span>
        Menu
      </summary>
      <div class="mobile-panel">
        <p class="mobile-label">Plugins</p>
        <ul class="mobile-list">
          <li><a href="/plugins/">All plugins</a></li>
          {
            CATEGORIES.map((category) => (
              <li>
                <a href={`/plugins/${category.slug}/`}>
                  <Icon name={category.icon} size={16} />
                  {category.name}
                </a>
              </li>
            ))
          }
        </ul>

        <p class="mobile-label">Learn</p>
        <ul class="mobile-list">
          {primaryNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li>
            <a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer">
              <Icon name="github" size={16} />
              GitHub
            </a>
          </li>
        </ul>

        <a class="btn btn-primary mobile-cta" href="/plugins/">Browse plugins</a>
      </div>
    </details>
  </div>
</header>

<script>
  for (const menu of document.querySelectorAll<HTMLDetailsElement>("[data-nav-menu], [data-mobile-menu]")) {
    document.addEventListener("click", (event) => {
      if (!menu.contains(event.target as Node)) menu.open = false;
    });

    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        menu.open = false;
        menu.querySelector<HTMLElement>("summary")?.focus();
      }
    });

    for (const link of menu.querySelectorAll("a")) {
      link.addEventListener("click", () => {
        menu.open = false;
      });
    }
  }
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 60;
    background-color: color-mix(in srgb, var(--af-bg) 91%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-block-end: 1px solid var(--af-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .brand img {
    width: 28px;
    height: 28px;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--af-text);
    white-space: nowrap;
  }

  .nav-desktop {
    margin-inline-start: auto;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border: 1px solid transparent;
    border-radius: var(--af-radius);
    color: var(--af-muted);
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
    transition:
      color var(--af-transition),
      border-color var(--af-transition),
      background-color var(--af-transition);
  }

  .nav-link::-webkit-details-marker {
    display: none;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--af-text);
    border-color: color-mix(in srgb, var(--af-accent) 28%, transparent);
    background-color: color-mix(in srgb, var(--af-accent) 9%, transparent);
  }

  .nav-caret {
    font-size: 10px;
    color: var(--af-accent);
  }

  .nav-menu {
    position: relative;
  }

  .nav-panel {
    position: absolute;
    inset-block-start: calc(100% + 10px);
    inset-inline-start: 0;
    z-index: 70;
    width: 270px;
    padding: 14px;
    background-color: var(--af-surface);
    border: 1px solid var(--af-border-strong);
    border-radius: var(--af-radius);
    box-shadow: 0 20px 50px color-mix(in srgb, var(--af-bg) 78%, transparent);
  }

  .nav-panel__label {
    margin: 2px 4px 8px;
    color: var(--af-muted);
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .nav-panel__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-panel__list a {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 10px;
    border-radius: 7px;
    color: var(--af-text);
    font-size: 15px;
    transition: background-color var(--af-transition), color var(--af-transition);
  }

  .nav-panel__list a:hover {
    background-color: color-mix(in srgb, var(--af-accent) 11%, transparent);
    color: var(--af-accent);
  }

  .nav-panel__list .af-icon {
    color: var(--af-accent);
  }

  .nav-panel__all {
    justify-content: space-between;
    margin-block-end: 4px;
    border: 1px solid var(--af-border);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .nav-panel__note {
    margin: 10px 4px 0;
    padding-block-start: 10px;
    border-block-start: 1px solid var(--af-border);
    color: var(--af-muted);
    font-size: 12px;
    line-height: 1.45;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-inline-start: 8px;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 10px;
    border-radius: var(--af-radius);
    color: var(--af-muted);
    font-size: 14px;
    transition: color var(--af-transition);
  }

  .github-link:hover {
    color: var(--af-accent);
  }

  .browse {
    padding: 9px 16px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mobile-menu {
    display: none;
    margin-inline-start: auto;
    position: relative;
  }

  .mobile-menu summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 13px;
    border: 1px solid var(--af-border-strong);
    border-radius: var(--af-radius);
    color: var(--af-text);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .burger {
    width: 16px;
    height: 2px;
    background-color: currentColor;
    box-shadow: 0 -5px 0 currentColor, 0 5px 0 currentColor;
  }

  .mobile-panel {
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: calc(100% + 10px);
    z-index: 70;
    width: min(330px, calc(100vw - 24px));
    max-height: calc(100vh - 90px);
    overflow-y: auto;
    padding: 12px;
    background-color: var(--af-surface);
    border: 1px solid var(--af-border);
    border-radius: var(--af-radius);
    box-shadow: 0 18px 40px color-mix(in srgb, var(--af-bg) 70%, transparent);
  }

  .mobile-label {
    margin: 8px 10px 4px;
    color: var(--af-accent);
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mobile-list {
    margin: 0 0 6px;
    padding: 0;
    list-style: none;
  }

  .mobile-list a {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 10px;
    border-radius: var(--af-radius);
    color: var(--af-text);
    font-size: 16px;
    transition: background-color var(--af-transition), color var(--af-transition);
  }

  .mobile-list a:hover {
    background-color: color-mix(in srgb, var(--af-accent) 12%, transparent);
    color: var(--af-accent);
  }

  .mobile-list .af-icon {
    color: var(--af-accent);
  }

  .mobile-cta {
    display: flex;
    margin: 8px 2px 2px;
  }

  @media (max-width: 1020px) {
    .github-link {
      display: none;
    }
  }

  @media (max-width: 940px) {
    .nav-desktop,
    .header-actions {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 560px) {
    .header-inner {
      gap: 8px;
      min-height: 58px;
    }

    .wordmark {
      font-size: 15px;
      letter-spacing: 0.05em;
    }

    .mobile-menu summary {
      padding-inline: 10px;
    }
  }
</style>
