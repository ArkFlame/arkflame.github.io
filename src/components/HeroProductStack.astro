---
import type { Product } from "@/data/products";

interface Props {
  primary: Product;
  foreground: Product[];
}

const { primary, foreground } = Astro.props;
const tiles = foreground.slice(0, 2);
---

<div class="hps" aria-label={`${primary.name} and featured products`}>
  <div class="hps__frame">
    {primary.image ? (
      <img class="hps__primary" src={primary.image} alt={`${primary.name} product preview`} />
    ) : (
      <div class="hps__fallback" role="img" aria-label={`${primary.name} preview unavailable`}>
        {primary.name}
      </div>
    )}
    {tiles.map((product, index) => (
      <div class:list={["hps__tile", `hps__tile--${index + 1}`]}>
        {product.image ? (
          <img src={product.image} alt={`${product.name} product preview`} />
        ) : (
          <div class="hps__fallback" role="img" aria-label={`${product.name} preview unavailable`}>
            {product.name}
          </div>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .hps {
    width: 100%;
    max-width: 620px;
    margin-inline: auto;
    padding: 38px 42px 42px;
  }

  .hps__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 3;
    border: 1px solid rgba(116, 199, 255, 0.24);
    border-radius: 18px;
    background: #0b1729;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.38);
  }

  .hps__primary,
  .hps__tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hps__primary { border-radius: inherit; }

  .hps__tile {
    position: absolute;
    overflow: hidden;
    border: 1px solid rgba(173, 218, 255, 0.38);
    border-radius: 12px;
    background: #101f34;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
  }

  .hps__tile--1 {
    top: -12%;
    right: -9%;
    width: 28%;
    aspect-ratio: 1;
    transform: rotate(5deg);
  }

  .hps__tile--2 {
    bottom: -11%;
    left: -8%;
    width: 22%;
    aspect-ratio: 1;
    transform: rotate(-6deg);
  }

  .hps__fallback {
    display: grid;
    width: 100%;
    height: 100%;
    padding: 12px;
    place-items: center;
    color: #dceaff;
    font-weight: 700;
    text-align: center;
  }

  @media (max-width: 760px) {
    .hps { padding: 26px 26px 30px; }
    .hps__tile--1 { width: 25%; }
    .hps__tile--2 { display: none; }
  }
</style>
