---
import type { Product } from "@/data/products";

interface Props {
  primary: Product;
  foreground: Product[];
}

const { primary, foreground } = Astro.props;
const tiles = foreground.slice(0, 2);
const primaryBase = primary.image?.replace(/\.webp$/, "");
---

<div class="hps" aria-label={`${primary.name} and featured products`}>
  <div class="hps__frame">
    {primary.image ? (
      <a class="hps__link" href={`/plugins/${primary.slug}/`} aria-label={`View ${primary.name}`}>
      <img
        class="hps__primary"
        src={primary.image}
        srcset={primaryBase === undefined ? undefined : `${primaryBase}-480.webp 480w, ${primaryBase}-720.webp 720w, ${primary.image} 1672w`}
        sizes="(max-width: 760px) 326px, 470px"
        alt={`${primary.name} product preview`}
        width="1672"
        height="941"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      </a>
    ) : (
      <div class="hps__fallback" role="img" aria-label={`${primary.name} preview unavailable`}>
        {primary.name}
      </div>
    )}
    {tiles.map((product, index) => (
      <a class:list={["hps__tile", `hps__tile--${index + 1}`]} href={`/plugins/${product.slug}/`} aria-label={`View ${product.name}`}>
        {product.icon ?? product.image ? (
          <img
            src={product.icon ?? product.image}
            alt={`${product.name} product preview`}
            width="512"
            height="512"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="hps__fallback" role="img" aria-label={`${product.name} preview unavailable`}>
            {product.name}
          </div>
        )}
      </a>
    ))}
  </div>
</div>

<style>
  .hps__link { display: block; width: 100%; height: 100%; border-radius: inherit; overflow: hidden; }
  a.hps__tile { display: block; }
  .hps {
    width: 100%;
    max-width: 470px;
    margin-inline: auto;
    padding: 20px 24px 24px;
  }

  .hps__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border: 1px solid rgba(116, 199, 255, 0.24);
    border-radius: 14px;
    background: #0b1729;
  }

  .hps__primary,
  .hps__tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hps__primary { border-radius: inherit; }

  .hps__tile {
    position: absolute;
    overflow: visible;
    border: 0;
    background: none;
  }

  .hps__tile img {
    object-fit: contain;
    filter: drop-shadow(0 8px 14px rgba(0, 0, 0, 0.4));
  }

  .hps__tile--1 {
    top: -8%;
    right: -7%;
    width: 25%;
    aspect-ratio: 1;
    transform: rotate(4deg);
  }

  .hps__tile--2 {
    bottom: -8%;
    left: -6%;
    width: 20%;
    aspect-ratio: 1;
    transform: rotate(-5deg);
  }

  .hps__fallback {
    display: grid;
    width: 100%;
    height: 100%;
    padding: 12px;
    place-items: center;
    color: #dceaff;
    font-weight: 700;
    text-align: center;
  }

  @media (max-width: 760px) {
    .hps { max-width: 400px; padding: 16px 20px 20px; }
    .hps__tile--1 { width: 23%; }
    .hps__tile--2 { display: none; }
  }
</style>
