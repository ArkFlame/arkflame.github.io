---
import type { Product } from "@/data/products";
import { getCategory } from "@/data/categories";
import { getProductsByCategory } from "@/data/products";
import { getProductDetail } from "@/data/product-details";
import { getArtworkSize, getResponsiveSrcSet } from "@/data/artwork";
import ProductCard from "@/components/ProductCard.astro";
import Icon from "@/components/Icon.astro";
import { getCollection } from "astro:content";

interface Props {
  product: Product;
}

const { product } = Astro.props;

const category = getCategory(product.category);
const categoryName = category?.name ?? product.category;
const detail = getProductDetail(product);
const size = getArtworkSize(product.slug);
const isSquare = size !== undefined && size.width === size.height;

const docs = (await getCollection("docs")).sort(
  (a, b) => b.data.updated.getTime() - a.data.updated.getTime(),
);
const docsEntry = docs.find((entry) => entry.data.plugin === product.slug);

const guides = (await getCollection("guides"))
  .filter((entry) => entry.data.relatedPlugins.includes(product.slug))
  .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime())
  .slice(0, 3);

const related = getProductsByCategory(product.category)
  .filter((candidate) => candidate.slug !== product.slug)
  .slice(0, 3);

const compatibility = detail.compatibility;
const evidenceLabel = detail.evidence === "repository" ? "Source-reviewed" : "Listing only";
---

<article class="af-product af-container">
  <nav class="af-breadcrumb" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/plugins/">Plugins</a></li>
      <li><a href={`/plugins/${product.category}/`}>{categoryName}</a></li>
      <li aria-current="page">{product.name}</li>
    </ol>
  </nav>

  <header class="af-product__hero">
    <div class:list={["af-product__media", { "af-product__media--square": isSquare }]}>
      {
        product.image !== undefined ? (
          <img
            src={product.image}
            srcset={getResponsiveSrcSet(product.image, size)}
            sizes="(max-width: 900px) 100vw, 560px"
            alt=""
            loading="eager"
            decoding="async"
            fetchpriority="high"
            width={size?.width}
            height={size?.height}
          />
        ) : (
          <div class="af-product__placeholder">
            {category !== undefined && <Icon name={category.icon} size={42} />}
            <span>{product.name}</span>
            <small>{categoryName}</small>
          </div>
        )
      }
    </div>

    <div class="af-product__copy">
      <p class="af-product__kicker">
        <a href={`/plugins/${product.category}/`}>{categoryName}</a>
        <span aria-hidden="true">/</span>
        <span class="af-product__evidence">{evidenceLabel}</span>
      </p>

      <h1>{product.name}</h1>
      <p class="af-product__summary">{product.summary}</p>

      {
        product.tags.length > 0 && (
          <ul class="af-product__tags" aria-label="Tags">
            {product.tags.map((tag) => <li class="af-chip">{tag}</li>)}
          </ul>
        )
      }

      <div class="af-product__cta">
        <a class="btn btn-primary" href={product.storeUrl} target="_blank" rel="noopener noreferrer">
          Get on BuiltByBit
        </a>
        {
          docsEntry !== undefined ? (
            <a class="btn" href={`/docs/${docsEntry.id}/`}>Read documentation</a>
          ) : (
            <a class="btn" href="#compatibility">Check compatibility</a>
          )
        }
      </div>

      {
        product.officialUrl !== undefined && (
          <p class="af-product__official">
            <a href={product.officialUrl} target="_blank" rel="noopener noreferrer">
              Official website <span aria-hidden="true">↗</span>
            </a>
          </p>
        )
      }
    </div>
  </header>

  <div class="af-product__layout">
    <nav class="af-product__anchors" aria-label="On this page">
      <a href="#overview">Overview</a>
      <a href="#features">Features</a>
      <a href="#compatibility">Compatibility</a>
      <a href="#install">Install</a>
      {docsEntry !== undefined && <a href="#documentation">Documentation</a>}
    </nav>

    <div class="af-product__sections">
      <section id="overview" class="af-product__section">
        <h2>Overview</h2>
        <p>{detail.description}</p>
        <p class="af-product__note">
          {detail.evidence === "repository"
            ? "Product claims on this page were checked against the plugin repository. Runtime behaviour still depends on your server, dependencies and configuration."
            : "This listing has no local source repository in the ArkFlame workspace. Claims are limited to the public catalogue entry; no version, performance or rating data is asserted."}
        </p>
      </section>

      <section id="features" class="af-product__section">
        <h2>What it covers</h2>
        <ul class="af-product__features">
          {
            detail.highlights.map((highlight) => (
              <li>
                <span class="af-product__tick" aria-hidden="true">✓</span>
                {highlight}
              </li>
            ))
          }
        </ul>
      </section>

      <section id="compatibility" class="af-product__section">
        <h2>Compatibility</h2>
        {
          compatibility !== undefined ? (
            <>
              <dl class="af-product__facts">
                {compatibility.platforms !== undefined && (
                  <div>
                    <dt>Platforms</dt>
                    <dd>{compatibility.platforms.join(", ")}</dd>
                  </div>
                )}
                {compatibility.minecraft !== undefined && (
                  <div>
                    <dt>Minecraft</dt>
                    <dd>{compatibility.minecraft}</dd>
                  </div>
                )}
                {compatibility.java !== undefined && (
                  <div>
                    <dt>Java</dt>
                    <dd>{compatibility.java}</dd>
                  </div>
                )}
                {compatibility.folia !== undefined && (
                  <div>
                    <dt>Folia</dt>
                    <dd>{compatibility.folia === "declared" ? "Declared in the plugin manifest" : "Not declared"}</dd>
                  </div>
                )}
              </dl>
              <p class="af-product__source">
                Source: repository README and manifest, inspected 30 Oct 2026. Not runtime-tested.
              </p>
              {compatibility.note !== undefined && <p class="af-product__note">{compatibility.note}</p>}
            </>
          ) : (
            <div class="af-product__unverified">
              <p><strong>Not yet verified.</strong> This listing does not publish a platform, Minecraft version or Folia claim.</p>
              <p>Check the BuiltByBit listing for the seller's current requirements before you install it.</p>
            </div>
          )
        }
        <p class="af-product__note">
          Tags above describe the product's scope. They are not a compatibility matrix.
        </p>
      </section>

      <section id="install" class="af-product__section">
        <h2>Install</h2>
        {
          docsEntry !== undefined ? (
            <>
              <p>
                The quick start covers requirements, jar or module placement, first configuration and the failure
                messages worth checking before you open a support ticket.
              </p>
              <p><a class="af-product__inline-link" href={`/docs/${docsEntry.id}/`}>Open the {product.name} documentation →</a></p>
            </>
          ) : detail.evidence === "repository" ? (
            <p>
              The repository does not ship a user installation guide we can publish. Use the current BuiltByBit
              listing for the release artifact and its stated requirements. This page does not invent steps for it.
            </p>
          ) : (
            <p>
              No local source is available for this listing, so installation steps are not published here. Use the
              BuiltByBit listing for the current artifact and requirements.
            </p>
          )
        }
      </section>

      {
        docsEntry !== undefined && (
          <section id="documentation" class="af-product__section">
            <h2>Documentation</h2>
            <a class="af-product__docs-card" href={`/docs/${docsEntry.id}/`}>
              <span class="af-product__docs-kicker">Quick start</span>
              <span class="af-product__docs-title">{docsEntry.data.title}</span>
              <span class="af-product__docs-desc">{docsEntry.data.description}</span>
              <span class="af-product__docs-meta">
                Updated {docsEntry.data.updated.toISOString().slice(0, 10)}
                {docsEntry.data.runtimeVerified ? " · Runtime-verified" : " · Not runtime-verified"}
              </span>
            </a>
          </section>
        )
      }

      {
        guides.length > 0 && (
          <section class="af-product__section" aria-labelledby="related-guides">
            <h2 id="related-guides">Guides</h2>
            <ul class="af-product__guide-list">
              {guides.map((guide) => (
                <li>
                  <a href={`/guides/${guide.id}/`}>{guide.data.title}</a>
                  <p>{guide.data.description}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        related.length > 0 && (
          <section class="af-product__section" aria-labelledby="related-products">
            <h2 id="related-products">Related products</h2>
            <ul class="af-product__related">
              {related.map((item) => <ProductCard product={item} headingLevel="h3" />)}
            </ul>
          </section>
        )
      }
    </div>
  </div>
</article>

<style>
  .af-product {
    padding-block: 26px var(--af-section-y);
  }

  .af-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--af-muted);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .af-breadcrumb li + li::before {
    content: "/";
    margin-inline-end: 7px;
    color: var(--af-border-strong);
  }

  .af-breadcrumb a:hover {
    color: var(--af-accent);
  }

  .af-breadcrumb [aria-current="page"] {
    color: var(--af-accent);
  }

  .af-product__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 4vw, 52px);
    margin-block-start: 24px;
  }

  .af-product__media {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background:
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--af-primary) 20%, transparent), transparent 65%),
      var(--af-raised);
    border: 1px solid var(--af-border);
    border-radius: var(--af-radius);
  }

  .af-product__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .af-product__media--square img {
    object-fit: contain;
    padding: 20px;
  }

  .af-product__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 100%;
    padding: 24px;
    color: var(--af-muted);
    text-align: center;
  }

  .af-product__placeholder .af-icon {
    color: var(--af-accent);
  }

  .af-product__placeholder span {
    color: var(--af-text);
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
  }

  .af-product__placeholder small {
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .af-product__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    margin: 0;
    color: var(--af-muted);
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .af-product__kicker a {
    color: var(--af-accent);
  }

  .af-product__evidence {
    color: var(--af-muted);
  }

  .af-product h1 {
    margin: 8px 0 0;
    font-size: clamp(2.2rem, 4.8vw, 3.4rem);
    line-height: 1.02;
  }

  .af-product__summary {
    margin: 10px 0 0;
    color: var(--af-text);
    font-size: 19px;
    line-height: 1.5;
  }

  .af-product__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .af-product__tags .af-chip {
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 400;
  }

  .af-product__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-block-start: 20px;
  }

  .af-product__official {
    margin: 12px 0 0;
    font-size: 14px;
  }

  .af-product__official a {
    color: var(--af-muted);
  }

  .af-product__official a:hover {
    color: var(--af-accent);
  }

  .af-product__layout {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    margin-block-start: 46px;
    align-items: start;
  }

  .af-product__anchors {
    position: sticky;
    inset-block-start: 84px;
    display: grid;
    gap: 3px;
    padding: 12px;
    background-color: var(--af-raised);
    border: 1px solid var(--af-border);
    border-radius: var(--af-radius);
  }

  .af-product__anchors a {
    padding: 7px 9px;
    border-radius: 6px;
    color: var(--af-muted);
    font-size: 14px;
    transition: color var(--af-transition), background-color var(--af-transition);
  }

  .af-product__anchors a:hover {
    background-color: color-mix(in srgb, var(--af-accent) 10%, transparent);
    color: var(--af-accent);
  }

  .af-product__section {
    scroll-margin-top: 84px;
    padding-block-end: 30px;
  }

  .af-product__section + .af-product__section {
    padding-block-start: 28px;
    border-block-start: 1px solid var(--af-border);
  }

  .af-product__section h2 {
    margin: 0 0 12px;
    font-size: 24px;
  }

  .af-product__section p {
    max-width: 72ch;
    margin: 0 0 12px;
    color: var(--af-muted);
    font-size: 15.5px;
    line-height: 1.7;
  }

  .af-product__note {
    color: var(--af-muted);
    font-size: 13.5px;
    line-height: 1.6;
    padding: 10px 12px;
    background-color: var(--af-raised);
    border-inline-start: 2px solid var(--af-border-strong);
    border-radius: 0 6px 6px 0;
  }

  .af-product__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .af-product__features li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    color: var(--af-text);
    font-size: 15px;
    line-height: 1.5;
  }

  .af-product__tick {
    flex: none;
    color: var(--af-accent);
    font-size: 13px;
    line-height: 1.6;
  }

  .af-product__facts {
    display: grid;
    gap: 0;
    margin: 0;
    border: 1px solid var(--af-border);
    border-radius: var(--af-radius);
    overflow: hidden;
  }

  .af-product__facts > div {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 14px;
    padding: 11px 14px;
  }

  .af-product__facts > div + div {
    border-block-start: 1px solid var(--af-border);
  }

  .af-product__facts dt {
    color: var(--af-muted);
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .af-product__facts dd {
    margin: 0;
    color: var(--af-text);
    font-size: 14.5px;
    line-height: 1.5;
  }

  .af-product__source {
    margin: 8px 0 0;
    color: var(--af-muted);
    font-size: 12.5px;
    line-height: 1.5;
  }

  .af-product__unverified {
    padding: 14px 16px;
    background-color: var(--af-raised);
    border: 1px dashed var(--af-border-strong);
    border-radius: var(--af-radius);
  }

  .af-product__unverified p {
    margin: 0 0 6px;
  }

  .af-product__unverified p:last-child {
    margin: 0;
  }

  .af-product__inline-link {
    color: var(--af-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .af-product__docs-card {
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-width: 640px;
    padding: 18px;
    background:
      linear-gradient(140deg, color-mix(in srgb, var(--af-primary) 13%, transparent), transparent 60%),
      var(--af-raised);
    border: 1px solid var(--af-border);
    border-radius: var(--af-radius);
    transition: border-color var(--af-transition);
  }

  .af-product__docs-card:hover {
    border-color: var(--af-accent);
  }

  .af-product__docs-kicker {
    color: var(--af-accent);
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .af-product__docs-title {
    color: var(--af-text);
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
  }

  .af-product__docs-desc {
    color: var(--af-muted);
    font-size: 14px;
  }

  .af-product__docs-meta {
    margin-block-start: 6px;
    color: var(--af-muted);
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .af-product__guide-list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .af-product__guide-list a {
    color: var(--af-text);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
  }

  .af-product__guide-list a:hover {
    color: var(--af-accent);
  }

  .af-product__guide-list p {
    margin: 3px 0 0;
    font-size: 14px;
  }

  .af-product__related {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 900px) {
    .af-product__hero {
      grid-template-columns: minmax(0, 1fr);
    }

    .af-product__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .af-product__anchors {
      position: static;
      display: flex;
      flex-wrap: wrap;
      gap: 2px;
    }
  }

  @media (max-width: 620px) {
    .af-product__features {
      grid-template-columns: minmax(0, 1fr);
    }

    .af-product__facts > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 3px;
    }

    .af-product__cta .btn {
      flex: 1 1 auto;
    }
  }
</style>
