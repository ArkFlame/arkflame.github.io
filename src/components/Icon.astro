const isBrand = name === "github" || name === "discord";
const markup = PATH[name];

if (markup === undefined) {
  throw new Error(`Icon: unknown icon "${name}"`);
}
---

<svg
  class:list={["af-icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isBrand ? "currentColor" : "none"}
  stroke={isBrand ? "none" : "currentColor"}
  stroke-width={isBrand ? undefined : 1.8}
  stroke-linecap={isBrand ? undefined : "round"}
  stroke-linejoin={isBrand ? undefined : "round"}
  aria-hidden="true"
  focusable="false"
  set:html={markup}
/>
