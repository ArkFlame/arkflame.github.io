---
import { SITE } from "../data/site";
import { CATEGORIES } from "../data/categories";
import Icon from "../components/Icon.astro";
---

<footer class="site-footer">
  <div class="af-container">
    <div class="footer-top">
      <a class="brand" href="/">
        <img src="/assets/img/arkflame-logo.webp" alt="" width="24" height="24" />
        <span class="brand-line">{SITE.brandLine}</span>
      </a>
      <a class="footer-cta" href="/plugins/">Browse all plugins <span aria-hidden="true">→</span></a>
    </div>

    <div class="footer-grid">
      <section class="group" aria-labelledby="footer-plugins">
        <h2 id="footer-plugins" class="group-title">Plugins</h2>
        <ul class="group-list">
          <li><a href="/plugins/">All plugins</a></li>
          {
            CATEGORIES.map((category) => (
              <li>
                <a href={`/plugins/${category.slug}/`}>{category.name}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="group" aria-labelledby="footer-learn">
        <h2 id="footer-learn" class="group-title">Learn</h2>
        <ul class="group-list">
          <li><a href="/docs/">Documentation</a></li>
          <li><a href="/guides/">Guides</a></li>
          <li><a href="/plugins/">Plugin catalogue</a></li>
          <li><a href="/about/">About ArkFlame</a></li>
        </ul>
      </section>

      <section class="group" aria-labelledby="footer-browser-tools">
        <h2 id="footer-browser-tools" class="group-title">Browser tools</h2>
        <ul class="group-list">
          <li><a href="/global-dom-optimizer/">Global DOM Optimizer</a></li>
          <li><a href="/global-dom-optimizer/privacy/">Extension privacy policy</a></li>
        </ul>
      </section>

      <section class="group" aria-labelledby="footer-elsewhere">
        <h2 id="footer-elsewhere" class="group-title">Elsewhere</h2>
        <ul class="group-list">
          <li>
            <a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer">
              <Icon name="github" size={15} />
              GitHub
            </a>
          </li>
          <li>
            <a href={SITE.discordUrl} target="_blank" rel="noopener noreferrer">
              <Icon name="discord" size={15} />
              Discord
            </a>
          </li>
          <li>
            <a href={SITE.builtByBitUrl} target="_blank" rel="noopener noreferrer">
              <Icon name="basket" size={15} />
              BuiltByBit resources
            </a>
          </li>
          <li>
            <a href={SITE.founderUrl} target="_blank" rel="noopener noreferrer">Founder site</a>
          </li>
        </ul>
      </section>
    </div>

    <p class="disclaimer">{SITE.nonAffiliation}</p>
  </div>
</footer>

<style>
  .site-footer {
    content-visibility: auto;
    contain-intrinsic-size: auto 420px;
    margin-block-start: 24px;
    padding-block: 42px 30px;
    background-color: color-mix(in srgb, var(--af-raised) 72%, transparent);
    border-block-start: 1px solid var(--af-border);
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block-end: 22px;
    border-block-end: 1px solid var(--af-border);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .brand img {
    width: 24px;
    height: 24px;
  }

  .brand-line {
    color: var(--af-text);
    font-size: 15px;
    font-weight: 500;
  }

  .footer-cta {
    color: var(--af-accent);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-cta:hover {
    text-decoration: underline;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 28px;
    padding-block: 26px;
  }

  .group-title {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--af-accent);
  }

  .group-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .group-list a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    color: var(--af-muted);
    font-size: 14.5px;
    transition: color var(--af-transition);
  }

  .group-list a:hover {
    color: var(--af-accent);
  }

  .disclaimer {
    margin: 0;
    padding-block-start: 18px;
    border-block-start: 1px solid var(--af-border);
    color: var(--af-muted);
    font-size: 13px;
  }

  @media (max-width: 560px) {
    .footer-grid {
      gap: 24px;
    }
  }
</style>
