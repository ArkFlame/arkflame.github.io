---
import { CAPABILITIES } from "@/data/site";

type Capability = (typeof CAPABILITIES)[number];

interface Props {
  capabilities?: readonly Capability[];
}

const { capabilities = CAPABILITIES } = Astro.props;
---

<section class="capabilities af-section" id="capabilities" aria-labelledby="capabilities-title">
  <div class="af-container">
    <header class="capabilities__header">
      <h2 id="capabilities-title">Five problems, one studio</h2>
    </header>
    <nav class="capabilities__rows" aria-label="Capabilities">
      {capabilities.map((capability) => (
        <a class="btn btn-outline capabilities__link" href={capability.href}>
          <i class={`bi ${capability.icon}`} aria-hidden="true"></i>
          <span>{capability.label}</span>
        </a>
      ))}
    </nav>
  </div>
</section>

<style>
  .capabilities__header {
    max-width: 820px;
    margin-bottom: 36px;
  }

  .capabilities__header h2 {
    margin-bottom: 12px;
    font-size: clamp(32px, 5vw, 46px);
  }

  .capabilities__rows {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .capabilities__link {
    display: inline-flex;
    flex: 1 1 170px;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    min-height: 46px;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .capabilities__link {
      flex-basis: calc(50% - 6px);
    }
  }

  @media (max-width: 360px) {
    .capabilities__link {
      flex-basis: 100%;
    }
  }
</style>
