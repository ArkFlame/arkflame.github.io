---
import type { Product, ProductCategory } from "@/data/products";
import { PRODUCTS, getProductsByCategory } from "@/data/products";
import type { CategoryInfo } from "@/data/categories";
import { getCategory, getCategorySlugs } from "@/data/categories";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CategoryPage from "@/components/CategoryPage.astro";
import ProductPage from "@/components/ProductPage.astro";
import { SITE } from "@/data/site";
import {
  absUrl,
  breadcrumb,
  graph,
  itemList,
  softwareApplication,
  webPage,
  type SchemaNode,
} from "@/data/schema";

/**
 * Single dynamic route owning both `/plugins/<category>/` and `/plugins/<product>/`.
 * products.ts already rejects product slugs that collide with a category slug at
 * import time; the explicit check below is a second, local guard so a collision
 * fails here too instead of silently emitting one path twice.
 */
export async function getStaticPaths() {
  const paths = [
    ...getCategorySlugs().map((slug) => ({
      params: { slug },
      props: { pageType: "category", category: getCategory(slug) },
    })),
    ...PRODUCTS.map((product) => ({
      params: { slug: product.slug },
      props: { pageType: "product", product },
    })),
  ];
  const seen = new Set<string>();
  for (const entry of paths) {
    const key = String(entry.params.slug);
    if (seen.has(key)) throw new Error(`Duplicate /plugins/ route: ${key}`);
    seen.add(key);
  }
  return paths;
}

type Props = { pageType: "category"; category: CategoryInfo } | { pageType: "product"; product: Product };

const { pageType, ...rest } = Astro.props;

/** Title-phrase table only; no product data is duplicated here. */
const CATEGORY_TITLE_PHRASE: Readonly<Record<ProductCategory, string>> = {
  security: "Minecraft security plugin",
  performance: "Minecraft performance plugin",
  network: "Minecraft proxy software",
  gameplay: "Minecraft gameplay plugin",
  smp: "Minecraft SMP plugin",
};

/** Product title: "<name> — <phrase> | ArkFlame", trimmed to 60 chars. */
function metaTitle(name: string, phrase: string): string {
  const full = `${name} — ${phrase} | ArkFlame`;
  if (full.length <= 60) return full;
  const short = `${name} — ${phrase}`;
  return short.length <= 60 ? short : `${short.slice(0, 59).trimEnd()}…`;
}

/** Product description: "<name>: <phrase>. <summary>" plus BuiltByBit, kept <= 155 chars. */
function metaDescription(name: string, phrase: string, summary: string): string {
  const suffix = " Get it on BuiltByBit.";
  const head = `${name}: ${phrase}. ${summary}`.replace(/\s+/g, " ").trim();
  const max = 155 - suffix.length;
  const body = head.length <= max ? head : `${head.slice(0, max - 1).replace(/\s+\S*$/, "")}…`;
  return `${body}${suffix}`;
}
const pluginsUrl = absUrl("/plugins/");

let jsonLd: SchemaNode;

if ("category" in rest) {
  const category = rest.category;
  const categoryUrl = absUrl(`/plugins/${category.slug}/`);
  const members = getProductsByCategory(category.slug);
  jsonLd = graph(
    webPage(
      "CollectionPage",
      `${categoryUrl}#collection`,
      category.h1,
      categoryUrl,
      category.intro,
      { mainEntity: { "@id": `${categoryUrl}#itemlist` }, breadcrumb: { "@id": `${categoryUrl}#breadcrumb` } },
    ),
    itemList(
      `${categoryUrl}#itemlist`,
      members.map((member) => ({ name: member.name, url: absUrl(`/plugins/${member.slug}/`) })),
    ),
    breadcrumb(`${categoryUrl}#breadcrumb`, [
      { name: "Minecraft Plugins", url: pluginsUrl },
      { name: category.name, url: categoryUrl },
    ]),
  );
} else {
  const product = rest.product;
  const category = getCategory(product.category);
  if (category === undefined) {
    throw new Error(`plugins/[slug]: unknown category "${product.category}" for product "${product.slug}"`);
  }
  const productUrl = absUrl(`/plugins/${product.slug}/`);
  const categoryUrl = absUrl(`/plugins/${category.slug}/`);
  jsonLd = graph(
    softwareApplication(product),
    breadcrumb(`${productUrl}#breadcrumb`, [
      { name: "Minecraft Plugins", url: pluginsUrl },
      { name: category.name, url: categoryUrl },
      { name: product.name, url: productUrl },
    ]),
  );
}
---

{
  "category" in rest ? (
    <BaseLayout
      title={rest.category.title}
      description={rest.category.intro}
      canonicalPath={`/plugins/${rest.category.slug}/`}
      jsonLd={jsonLd}
    >
      <CategoryPage category={rest.category} />
    </BaseLayout>
  ) : (
    <BaseLayout
      title={metaTitle(rest.product.name, CATEGORY_TITLE_PHRASE[rest.product.category])}
      description={metaDescription(
        rest.product.name,
        CATEGORY_TITLE_PHRASE[rest.product.category],
        rest.product.summary,
      )}
      canonicalPath={`/plugins/${rest.product.slug}/`}
      image={rest.product.image ?? SITE.ogImage}
      jsonLd={jsonLd}
    >
      <ProductPage product={rest.product} />
    </BaseLayout>
  )
}