---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductCatalog from "@/components/ProductCatalog.astro";
import { PRODUCTS } from "@/data/products";
import { absUrl, breadcrumb, graph, itemList, webPage } from "@/data/schema";

const TITLE = "Minecraft Plugins | ArkFlame Studios";
const DESCRIPTION =
  "Browse ArkFlame Minecraft plugins for server security, performance, proxies, SMP gameplay, anticheat, authentication and optimization.";

const pluginsUrl = absUrl("/plugins/");

const jsonLd = graph(
  webPage("CollectionPage", `${pluginsUrl}#collection`, "Minecraft Plugins", pluginsUrl, DESCRIPTION, {
    mainEntity: { "@id": `${pluginsUrl}#itemlist` },
    breadcrumb: { "@id": `${pluginsUrl}#breadcrumb` },
  }),
  itemList(
    `${pluginsUrl}#itemlist`,
    PRODUCTS.map((product) => ({ name: product.name, url: absUrl(`/plugins/${product.slug}/`) })),
  ),
  breadcrumb(`${pluginsUrl}#breadcrumb`, [{ name: "Minecraft Plugins", url: pluginsUrl }]),
);
---

<BaseLayout title={TITLE} description={DESCRIPTION} canonicalPath="/plugins/" jsonLd={jsonLd}>
  <ProductCatalog products={PRODUCTS} />
</BaseLayout>