---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleLayout from "@/components/ArticleLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import { getProduct } from "@/data/products";
import { SITE } from "@/data/site";
import { absUrl, article, breadcrumb, faqPage, graph } from "@/data/schema";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((entry) => ({
    params: { slug: entry.id },
    props: { slug: entry.id },
  }));
}

const { slug } = Astro.props;
const entry = await getEntry("guides", slug);
if (entry === undefined) throw new Error(`guides/[slug]: no entry for "${slug}"`);

const { Content, headings } = await render(entry);
const related = entry.data.relatedPlugins
  .map((pluginSlug) => getProduct(pluginSlug))
  .filter((product) => product !== undefined);

const docs = (await getCollection("docs")).filter((doc) =>
  entry.data.relatedPlugins.includes(doc.data.plugin),
);

const relatedGuides = (await getCollection("guides"))
  .filter((guide) => guide.id !== entry.id)
  .map((guide) => ({
    guide,
    score:
      guide.data.topics.filter((topic) => entry.data.topics.includes(topic)).length +
      guide.data.relatedPlugins.filter((plugin) => entry.data.relatedPlugins.includes(plugin)).length,
  }))
  .filter((item) => item.score > 0)
  .sort((a, b) => b.score - a.score || a.guide.data.title.localeCompare(b.guide.data.title))
  .slice(0, 3)
  .map((item) => item.guide);

/** FAQ entries come from a "## Frequently asked questions" section: "### question" then the answer. */
function parseFaq(body: string | undefined) {
  if (body === undefined) return [];
  const start = body.search(/^## Frequently asked questions\s*$/m);
  if (start < 0) return [];
  const rest = body.slice(start).replace(/^## .*\r?\n/, "");
  const end = rest.search(/^## /m);
  const section = end < 0 ? rest : rest.slice(0, end);
  return section
    .split(/^### /m)
    .slice(1)
    .map((block) => {
      const [question, ...answer] = block.split(/\r?\n/);
      return {
        question: question.trim(),
        answer: answer.join(" ").replace(/\[([^\]]+)\]\([^)]+\)/g, "$1").trim(),
      };
    })
    .filter((item) => item.question !== "" && item.answer !== "");
}

const faq = parseFaq(entry.body);

const path = `/guides/${entry.id}/`;
const url = `${SITE.siteUrl}${path}`;

const jsonLd = graph(
  faq.length > 0 ? faqPage(`${url}#faq`, faq) : undefined,
  article({
    type: "Article",
    url,
    headline: entry.data.title,
    description: entry.data.description,
    dateModified: entry.data.updated,
    image: related[0]?.image,
    author:
      entry.data.author === SITE.founderHandle
        ? { "@type": "Person", name: SITE.founderName, url: SITE.founderUrl }
        : { "@type": "Person", name: entry.data.author },
  }),
  breadcrumb(`${url}#breadcrumb`, [
    { name: "Guides", url: absUrl("/guides/") },
    { name: entry.data.title, url },
  ]),
);
---

<BaseLayout
  title={`${entry.data.title} | ArkFlame Guides`}
  description={entry.data.description}
  canonicalPath={path}
  ogType="article"
  jsonLd={jsonLd}
>
  <ArticleLayout
    eyebrow="Technical guide"
    title={entry.data.title}
    description={entry.data.description}
    updated={entry.data.updated}
    author={entry.data.author}
    headings={headings}
    backHref="/guides/"
    backLabel="Guides"
    sectionLabel={entry.data.topics[0] ?? "Guide"}
    drawerLabel="Products and contents"
  >
    <nav slot="sidebar" class="guide-nav" aria-label="Related products and docs">
      {
        related.length > 0 && (
          <div class="guide-nav__group">
            <p class="guide-nav__label">Products in this guide</p>
            <ul>
              {related.map((product) => (
                <li><a href={`/plugins/${product.slug}/`}>{product.name}</a></li>
              ))}
            </ul>
          </div>
        )
      }
      {
        docs.length > 0 && (
          <div class="guide-nav__group">
            <p class="guide-nav__label">Documentation</p>
            <ul>
              {docs.map((doc) => (
                <li><a href={`/docs/${doc.id}/`}>{doc.data.title}</a></li>
              ))}
            </ul>
          </div>
        )
      }
    </nav>

    <Content />

    <div slot="footer" class="guide-footer">
      {
        related.length > 0 && (
          <div>
            <h2>Product pages</h2>
            <ul>
              {related.map((product) => (
                <li>
                  <a href={`/plugins/${product.slug}/`}>
                    {product.name} <span aria-hidden="true">→</span>
                  </a>
                  <p>{product.summary}</p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        relatedGuides.length > 0 && (
          <div>
            <h2>Related guides</h2>
            <ul>
              {relatedGuides.map((guide) => (
                <li>
                  <a href={`/guides/${guide.id}/`}>{guide.data.title}</a>
                  <p>{guide.data.description}</p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <p class="guide-footer__note">
        ArkFlame Studios · 30 October 2026
      </p>
    </div>
  </ArticleLayout>
</BaseLayout>

<style>
  .guide-nav {
    padding: 12px;
    background-color: var(--af-raised);
    border: 1px solid var(--af-border);
    border-radius: var(--af-radius);
  }

  .guide-nav__group + .guide-nav__group {
    margin-block-start: 14px;
    padding-block-start: 12px;
    border-block-start: 1px solid var(--af-border);
  }

  .guide-nav__label {
    margin: 0 0 5px;
    color: var(--af-accent);
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .guide-nav ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-nav a {
    display: block;
    padding: 5px 7px;
    border-radius: 5px;
    color: var(--af-muted);
    font-size: 13px;
    line-height: 1.45;
  }

  .guide-nav a:hover {
    background-color: color-mix(in srgb, var(--af-accent) 10%, transparent);
    color: var(--af-accent);
  }

  .guide-footer {
    display: grid;
    gap: 22px;
    margin-block-start: 40px;
    padding-block-start: 24px;
    border-block-start: 1px solid var(--af-border);
  }

  .guide-footer h2 {
    margin: 0 0 10px;
    font-size: 19px;
  }

  .guide-footer ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-footer li a {
    color: var(--af-text);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
  }

  .guide-footer li a:hover {
    color: var(--af-accent);
  }

  .guide-footer li p {
    margin: 3px 0 0;
    color: var(--af-muted);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .guide-footer__note {
    margin: 0;
    color: var(--af-muted);
    font-size: 12.5px;
  }
</style>
