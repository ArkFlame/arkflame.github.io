---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleLayout from "@/components/ArticleLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import { getProduct } from "@/data/products";
import { SITE } from "@/data/site";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((entry) => ({
    params: { slug: entry.id },
    props: { slug: entry.id },
  }));
}

const { slug } = Astro.props;
const entry = await getEntry("guides", slug);
if (entry === undefined) throw new Error(`guides/[slug]: no entry for "${slug}"`);

const { Content, headings } = await render(entry);
const related = entry.data.relatedPlugins
  .map((pluginSlug) => getProduct(pluginSlug))
  .filter((product) => product !== undefined);

const docs = (await getCollection("docs")).filter((doc) =>
  entry.data.relatedPlugins.includes(doc.data.plugin),
);

const path = `/guides/${entry.id}/`;
const url = `${SITE.siteUrl}${path}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": `${url}#article`,
      headline: entry.data.title,
      description: entry.data.description,
      url,
      mainEntityOfPage: url,
      dateModified: entry.data.updated.toISOString(),
      inLanguage: "en-US",
      author: { "@type": "Person", name: entry.data.author },
      publisher: { "@id": `${SITE.siteUrl}/#organization` },
      isPartOf: { "@id": `${SITE.siteUrl}/#website` },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${url}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.siteUrl}/` },
        { "@type": "ListItem", position: 2, name: "Guides", item: `${SITE.siteUrl}/guides/` },
        { "@type": "ListItem", position: 3, name: entry.data.title, item: url },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${entry.data.title} | ArkFlame Guides`}
  description={entry.data.description}
  canonicalPath={path}
  ogType="article"
  jsonLd={jsonLd}
>
  <ArticleLayout
    eyebrow="Technical guide"
    title={entry.data.title}
    description={entry.data.description}
    updated={entry.data.updated}
    author={entry.data.author}
    headings={headings}
    backHref="/guides/"
    backLabel="Guides"
    sectionLabel={entry.data.topics[0] ?? "Guide"}
    drawerLabel="Products and contents"
  >
    <nav slot="sidebar" class="guide-nav" aria-label="Related products and docs">
      {
        related.length > 0 && (
          <div class="guide-nav__group">
            <p class="guide-nav__label">Products in this guide</p>
            <ul>
              {related.map((product) => (
                <li><a href={`/plugins/${product.slug}/`}>{product.name}</a></li>
              ))}
            </ul>
          </div>
        )
      }
      {
        docs.length > 0 && (
          <div class="guide-nav__group">
            <p class="guide-nav__label">Documentation</p>
            <ul>
              {docs.map((doc) => (
                <li><a href={`/docs/${doc.id}/`}>{doc.data.title}</a></li>
              ))}
            </ul>
          </div>
        )
      }
    </nav>

    <Content />

    <div slot="footer" class="guide-footer">
      {
        related.length > 0 && (
          <div>
            <h2>Product pages</h2>
            <ul>
              {related.map((product) => (
                <li>
                  <a href={`/plugins/${product.slug}/`}>
                    {product.name} <span aria-hidden="true">→</span>
                  </a>
                  <p>{product.summary}</p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <p class="guide-footer__note">
        Reviewed against the named repositories and documentation on 30 October 2026. No runtime test was performed
        unless the article says otherwise.
      </p>
    </div>
  </ArticleLayout>
</BaseLayout>

<style>
  .guide-nav {
    padding: 12px;
    background-color: var(--af-raised);
    border: 1px solid var(--af-border);
    border-radius: var(--af-radius);
  }

  .guide-nav__group + .guide-nav__group {
    margin-block-start: 14px;
    padding-block-start: 12px;
    border-block-start: 1px solid var(--af-border);
  }

  .guide-nav__label {
    margin: 0 0 5px;
    color: var(--af-accent);
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .guide-nav ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-nav a {
    display: block;
    padding: 5px 7px;
    border-radius: 5px;
    color: var(--af-muted);
    font-size: 13px;
    line-height: 1.45;
  }

  .guide-nav a:hover {
    background-color: color-mix(in srgb, var(--af-accent) 10%, transparent);
    color: var(--af-accent);
  }

  .guide-footer {
    display: grid;
    gap: 22px;
    margin-block-start: 40px;
    padding-block-start: 24px;
    border-block-start: 1px solid var(--af-border);
  }

  .guide-footer h2 {
    margin: 0 0 10px;
    font-size: 19px;
  }

  .guide-footer ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-footer li a {
    color: var(--af-text);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
  }

  .guide-footer li a:hover {
    color: var(--af-accent);
  }

  .guide-footer li p {
    margin: 3px 0 0;
    color: var(--af-muted);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .guide-footer__note {
    margin: 0;
    color: var(--af-muted);
    font-size: 12.5px;
  }
</style>
