---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroProductStack from "@/components/HeroProductStack.astro";
import ProductRail from "@/components/ProductRail.astro";
import { SITE, HERO, PLATFORM_STRIP } from "@/data/site";
import { getProduct } from "@/data/products";
import { getCollection } from "astro:content";

const docsCount = (await getCollection("docs")).length;
const guideCount = (await getCollection("guides")).length;

const selected = ["flamecord", "exploitfixer", "fairplay", "authme-premium", "redstonelimiter"]
  .map((slug) => getProduct(slug))
  .filter((product) => product !== undefined);
const security = ["exploitfixer", "fairplay", "authme-premium", "chatsentinel"]
  .map((slug) => getProduct(slug))
  .filter((product) => product !== undefined);
const performance = ["redstonelimiter", "entitylimiter", "flamepaper", "flamestack"]
  .map((slug) => getProduct(slug))
  .filter((product) => product !== undefined);
const network = ["flamecord", "veloflame", "discordflow"]
  .map((slug) => getProduct(slug))
  .filter((product) => product !== undefined);
const smp = ["smp-lifesteal", "smp-punishments", "smp-combat", "smp-menus", "smp-regions"]
  .map((slug) => getProduct(slug))
  .filter((product) => product !== undefined);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE.siteUrl}/#organization`,
      name: SITE.name,
      url: `${SITE.siteUrl}/`,
      logo: `${SITE.siteUrl}${SITE.logo}`,
      image: `${SITE.siteUrl}${SITE.ogImage}`,
      description:
        "ArkFlame Studios builds Minecraft server software for security, performance, proxies, anticheat and SMP gameplay.",
      sameAs: [
        SITE.githubUrl,
        SITE.builtByBitUrl,
        SITE.discordUrl,
        getProduct("flamecord")?.officialUrl,
        getProduct("exploitfixer")?.officialUrl,
        getProduct("veloflame")?.officialUrl,
        getProduct("fairplay")?.officialUrl,
        SITE.founderUrl,
      ].filter((url): url is string => url !== undefined),
    },
    {
      "@type": "WebSite",
      "@id": `${SITE.siteUrl}/#website`,
      name: SITE.name,
      url: `${SITE.siteUrl}/`,
      publisher: { "@id": `${SITE.siteUrl}/#organization` },
      inLanguage: "en-US",
    },
  ],
};
---

<BaseLayout
  title="Minecraft Plugins & Server Software | ArkFlame Studios"
  description="Minecraft plugins, anticheat, authentication and proxy software for security, performance and SMP servers. Source-reviewed docs from ArkFlame Studios."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section class="hm">
    <div class="af-container hm__inner">
      <div class="hm__copy">
        <p class="af-eyebrow">{HERO.eyebrow}</p>
        <h1 class="hm__title">We make <span class="hm__accent">Minecraft</span> plugins.</h1>
        <p class="hm__lead">{HERO.body}</p>
        <div class="hm__actions">
          <a class="btn btn-primary" href="/plugins/">Browse plugins</a>
          <a class="btn" href="/docs/">Read the docs</a>
        </div>
        <p class="hm__meta">
          <span>{docsCount} plugin guides</span>
          <span aria-hidden="true">·</span>
          <a href="/guides/">{guideCount} technical articles</a>
        </p>
      </div>

      <div class="hm__art">
        <HeroProductStack
          primary={getProduct("flamecord")!}
          foreground={[getProduct("exploitfixer")!, getProduct("fairplay")!]}
        />
      </div>
    </div>
  </section>

  <div class="ps" aria-label="Platforms across the catalogue">
    <div class="af-container ps__inner">
      <ul class="ps__list">
        {
          PLATFORM_STRIP.map((platform) => (
            <li class="ps__item">
              <img src={platform.logo} alt={platform.label} loading="lazy" decoding="async" width="112" height="30" />
            </li>
          ))
        }
      </ul>
      <p class="ps__caption">Platform support is product-specific. Each plugin page states what the source declares.</p>
    </div>
  </div>

  <div class="rail-stack">
    <ProductRail
      id="selected"
      eyebrow="Selected"
      title="Start with these."
      description="The products with the deepest source-reviewed documentation and the broadest install surfaces."
      products={selected}
      allHref="/plugins/"
      allLabel="All 51 plugins"
    />

    <ProductRail
      id="security"
      eyebrow="Security"
      title="Stop abuse before it reaches gameplay."
      description="Exploit filtering, combat anticheat, authentication bridges and chat moderation."
      products={security}
      allHref="/plugins/security/"
      allLabel="Security plugins"
    />

    <ProductRail
      id="performance"
      eyebrow="Performance"
      title="Cap the work that costs tick time."
      description="Redstone, entity, block and item limits, plus a Paper 1.8.8 server fork."
      products={performance}
      allHref="/plugins/performance/"
      allLabel="Performance plugins"
    />

    <ProductRail
      id="network"
      eyebrow="Network"
      title="Harden the proxy layer."
      description="Bungee-compatible and Velocity proxies with firewall, rate-limit and bridging tools."
      products={network}
      allHref="/plugins/network/"
      allLabel="Network software"
    />

    <ProductRail
      id="smp"
      eyebrow="SMP"
      title="Build the survival loop."
      description="Claims, combat tags, lifesteal, spawners, menus, lobbies and rewards."
      products={smp}
      allHref="/plugins/smp/"
      allLabel="SMP plugins"
    />
  </div>

  <section class="closing af-section">
    <div class="af-container closing__inner">
      <div>
        <p class="af-eyebrow">DOCUMENTATION</p>
        <h2 class="closing__title">Read the source-backed detail.</h2>
        <p class="closing__body">
          Installation requirements, real commands, permission nodes and the limits we could not verify — written from the plugin repositories, not the store copy.
        </p>
      </div>
      <div class="closing__actions">
        <a class="btn btn-primary" href="/docs/">Browse docs</a>
        <a class="btn" href="/guides/">Read guides</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hm {
    padding-block: clamp(34px, 6vw, 72px) clamp(30px, 5vw, 56px);
  }

  .hm__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px 52px;
  }

  .hm__copy {
    flex: 1 1 420px;
    min-width: 0;
  }

  .hm__title {
    margin: 0.28em 0 0.22em;
    font-size: clamp(2.45rem, 4.6vw, 3.6rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .hm__accent {
    color: var(--af-accent);
  }

  .hm__lead {
    max-width: 50ch;
    margin: 0 0 24px;
    color: var(--af-muted);
    font-size: 17px;
    line-height: 1.6;
  }

  .hm__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hm__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 0;
    color: var(--af-muted);
    font-size: 13px;
  }

  .hm__meta a {
    color: var(--af-accent);
  }

  .hm__meta a:hover {
    text-decoration: underline;
  }

  .hm__art {
    flex: 1 1 360px;
    min-width: 0;
    max-width: 500px;
    margin-inline: auto;
  }

  .ps {
    border-block: 1px solid var(--af-border);
    background-color: color-mix(in srgb, var(--af-raised) 65%, transparent);
  }

  .ps__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 26px;
    padding-block: 16px;
  }

  .ps__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ps__item img {
    display: block;
    width: auto;
    max-width: 100px;
    height: 26px;
    object-fit: contain;
    opacity: 0.86;
  }

  .ps__caption {
    max-width: 46ch;
    margin: 0;
    color: var(--af-muted);
    font-size: 12.5px;
    line-height: 1.5;
  }

  .rail-stack {
    padding-block: 8px;
  }

  .closing {
    padding-block: 30px 54px;
  }

  .closing__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 22px 40px;
    padding: 28px 30px;
    background:
      linear-gradient(130deg, color-mix(in srgb, var(--af-primary) 13%, transparent), transparent 60%),
      var(--af-raised);
    border: 1px solid var(--af-border);
    border-radius: var(--af-radius);
  }

  .closing__title {
    margin: 4px 0 0;
    font-size: clamp(1.45rem, 2.6vw, 1.85rem);
  }

  .closing__body {
    max-width: 64ch;
    margin: 8px 0 0;
    color: var(--af-muted);
    font-size: 15px;
  }

  .closing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 760px) {
    .hm__inner {
      gap: 24px;
    }

    .hm__art {
      max-width: 420px;
    }

    .closing__inner {
      padding: 22px;
    }
  }
</style>
