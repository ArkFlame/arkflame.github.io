---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroProductStack from "@/components/HeroProductStack.astro";
import FounderCard from "@/components/FounderCard.astro";
import ProductCard from "@/components/ProductCard.astro";
import Icon from "@/components/Icon.astro";
import { SITE, HERO, PLATFORM_STRIP } from "@/data/site";
import { PRODUCTS, getProduct, getProductsByCategory } from "@/data/products";
import { CATEGORIES } from "@/data/categories";
import { STORE_STATS, STATS_AS_OF } from "@/data/store-stats";
import { getCollection } from "astro:content";
import { absUrl, graph, webPage } from "@/data/schema";

const docsCount = (await getCollection("docs")).length;
const allGuides = await getCollection("guides");
const guideCount = allGuides.length;
const topGuides = [
  "anti-bot-setup-bungeecord-velocity",
  "crash-and-dupe-protection-checklist",
  "diagnose-lag-before-limiters",
  "folia-compatible-plugins",
]
  .map((slug) => allGuides.find((entry) => entry.id === slug))
  .filter((entry): entry is (typeof allGuides)[number] => entry !== undefined);

const popularQuestions: { q: string; a: string; href?: string; label?: string }[] = [
  {
    q: "Are ArkFlame products plugins or proxy software?",
    a: "Most are Bukkit, Spigot or Paper plugins. FlameCord and VeloFlame are proxy software for BungeeCord, Waterfall or Velocity. FlamePaper is a Paper 1.8.8 server fork that replaces the server jar.",
  },
  {
    q: "Do the products support Folia?",
    a: "ExploitFixer, FairPlay and FlameStack declare Folia support in their repositories, and several store listings advertise it. A declaration is not a runtime test, so check it on your own Folia server.",
  },
  {
    q: "What stops bot floods on a proxy?",
    a: "FlameCord (BungeeCord or Waterfall) and VeloFlame (Velocity) include anti-bot modules. The anti-bot setup guide covers the proxy and the backend lock-down.",
    href: "/guides/anti-bot-setup-bungeecord-velocity/",
    label: "Read the anti-bot setup guide",
  },
  {
    q: "Where are the install steps?",
    a: "Install steps, commands and permissions are in the docs. Each product page links to its BuiltByBit listing.",
    href: "/docs/",
    label: "Browse the docs",
  },
];

const purchasesOf = (slug: string): number => STORE_STATS[slug]?.purchases ?? 0;

const totalSold = PRODUCTS.reduce((sum, product) => sum + purchasesOf(product.slug), 0);
const ratings = PRODUCTS.flatMap((product) => {
  const rating = STORE_STATS[product.slug]?.rating;
  return rating === undefined ? [] : [rating];
});
const averageRating = ratings.length === 0 ? 0 : ratings.reduce((a, b) => a + b, 0) / ratings.length;
const asOf = new Date(`${STATS_AS_OF}T00:00:00Z`).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});

const popular = [...PRODUCTS]
  .sort((a, b) => purchasesOf(b.slug) - purchasesOf(a.slug))
  .slice(0, 8);

const jsonLd = graph(
  webPage(
    "WebPage",
    `${absUrl("/")}#webpage`,
    "Minecraft Plugins & Server Software | ArkFlame Studios",
    absUrl("/"),
    "Minecraft plugins, anticheat, authentication and proxy software for security, performance and SMP servers. Built by ArkFlame Studios.",
  ),
);
---

<BaseLayout
  title="Minecraft Plugins & Server Software | ArkFlame Studios"
  description="Minecraft plugins, anticheat, authentication and proxy software for security, performance and SMP servers. Built by ArkFlame Studios."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section class="hm">
    <div class="af-container hm__inner">
      <div class="hm__copy">
        <p class="af-eyebrow">{HERO.eyebrow}</p>
        <h1 class="hm__title">{HERO.h1}</h1>
        <p class="hm__lead">{HERO.body}</p>
        <div class="hm__actions">
          <a class="btn btn-primary" href="/plugins/">{HERO.primaryCta}</a>
          <a class="btn" href="/docs/">{HERO.secondaryCta}</a>
        </div>
      </div>

      <div class="hm__art">
        <HeroProductStack
          primary={getProduct("flamecord")!}
          foreground={[getProduct("exploitfixer")!, getProduct("fairplay")!]}
        />
      </div>
    </div>
  </section>

  <section class="nums af-container" aria-label="Catalogue numbers">
    <dl class="nums__list">
      <div>
        <dt>Plugins</dt>
        <dd>{PRODUCTS.length}</dd>
      </div>
      <div>
        <dt>Sales on BuiltByBit</dt>
        <dd>{totalSold.toLocaleString("en-US")}</dd>
      </div>
      <div>
        <dt>Average rating</dt>
        <dd>★ {averageRating.toFixed(1)}</dd>
      </div>
    </dl>
  </section>

  <div class="ps" aria-label="Platforms">
    <div class="af-container ps__inner">
      <ul class="ps__list">
        {PLATFORM_STRIP.map((platform) => <li class="ps__item">{platform.label}</li>)}
      </ul>
    </div>
  </div>

  <section class="pop af-container af-section" aria-labelledby="popular-title">
    <div class="pop__head">
      <h2 class="pop__title" id="popular-title">Most popular.</h2>
      <p class="pop__desc">Top eight by BuiltByBit purchases, as of {asOf}.</p>
    </div>
    <ul class="pop__grid">
      {popular.map((product) => <ProductCard product={product} headingLevel="h3" />)}
    </ul>
    <p class="pop__all"><a href="/plugins/?sort=purchases">All {PRODUCTS.length} plugins →</a></p>
  </section>

  <section class="pq af-container af-section" aria-labelledby="pq-title">
    <h2 class="pq__title" id="pq-title">Popular questions.</h2>
    <dl class="pq__list">
      {
        popularQuestions.map((item) => (
          <div class="pq__item">
            <dt>{item.q}</dt>
            <dd>
              {item.a}
              {item.href !== undefined && item.label !== undefined && (
                <> <a href={item.href}>{item.label} →</a></>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="cats af-container af-section" aria-labelledby="cats-title">
    <h2 class="cats__title" id="cats-title">Browse by category.</h2>
    <ul class="cats__list">
      {
        CATEGORIES.map((category) => (
          <li>
            <a class="cats__card" href={`/plugins/${category.slug}/`}>
              <span class="cats__head">
                <Icon name={category.icon} size={20} />
                <span class="cats__name">{category.name}</span>
                <span class="cats__count">{getProductsByCategory(category.slug).length}</span>
              </span>
              <span class="cats__desc">{category.intro}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="founder-home af-container af-section" aria-labelledby="founder-heading">
    <FounderCard headingId="founder-heading" compact>
      <p class="founder-home__body">
        LinsaFTW is an Argentine software developer who designs, builds and
        releases the products listed here.
      </p>
      <a class="btn" href="/about/">About the founder</a>
    </FounderCard>
  </section>

  <section class="docs af-container af-section" aria-labelledby="docs-title">
    <div class="docs__inner">
      <div>
        <h2 class="docs__title" id="docs-title">Read the documentation.</h2>
        <p class="docs__body">Installation, commands, permissions and configuration.</p>
        <ul class="docs__guides">
          {
            topGuides.map((guide) => (
              <li><a href={`/guides/${guide.id}/`}>{guide.data.title}</a></li>
            ))
          }
        </ul>
      </div>
      <ul class="docs__links">
        <li><a class="btn btn-primary" href="/docs/">Docs ({docsCount})</a></li>
        <li><a class="btn" href="/guides/">Guides ({guideCount})</a></li>
      </ul>
    </div>
  </section>

</BaseLayout>

<style>
  .hm {
    padding-block: clamp(34px, 6vw, 72px) clamp(24px, 4vw, 40px);
  }

  .hm__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px 52px;
  }

  .hm__copy {
    flex: 1 1 420px;
    min-width: 0;
  }

  .hm__title {
    margin: 0.28em 0 0.22em;
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .hm__lead {
    max-width: 52ch;
    margin: 0 0 24px;
    color: var(--af-muted);
    font-size: 17px;
    line-height: 1.6;
  }

  .hm__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hm__art {
    flex: 1 1 360px;
    min-width: 0;
    max-width: 500px;
    margin-inline: auto;
  }

  .nums__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    border: 1px solid var(--af-border);
    border-radius: var(--af-radius);
    background: var(--af-raised);
  }

  .nums__list > div {
    padding: 14px 18px;
    min-width: 0;
  }

  .nums__list > div + div {
    border-inline-start: 1px solid var(--af-border);
  }

  .nums dt {
    color: var(--af-muted);
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .nums dd {
    margin: 2px 0 0;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .ps {
    margin-block-start: 28px;
    border-block: 1px solid var(--af-border);
    background-color: color-mix(in srgb, var(--af-raised) 65%, transparent);
  }

  .ps__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 26px;
    padding-block: 14px;
  }

  .ps__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ps__item {
    padding: 6px 12px;
    border: 1px solid var(--af-border-strong);
    border-radius: 999px;
    color: var(--af-text);
    font-size: 14px;
  }

  .cats,
  .docs {
    content-visibility: auto;
    contain-intrinsic-size: auto 600px;
  }

  .cats__title,
  .docs__title {
    margin: 0;
    font-size: clamp(1.5rem, 2.8vw, 1.95rem);
  }

  .cats__list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .cats__card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 16px;
    background: var(--af-surface);
    border: 1px solid var(--af-border);
    border-radius: var(--af-radius);
    color: var(--af-text);
    text-decoration: none;
    transition: border-color var(--af-transition), background-color var(--af-transition);
  }

  .cats__card:hover {
    border-color: var(--af-accent);
    background-color: var(--af-surface-2);
  }

  .cats__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: var(--af-accent);
  }

  .cats__name {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--af-text);
  }

  .cats__count {
    margin-inline-start: auto;
    color: var(--af-muted);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .cats__desc {
    display: -webkit-box;
    overflow: hidden;
    color: var(--af-muted);
    font-size: 13px;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .docs__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 30px;
    padding: 22px 26px;
    background: var(--af-raised);
    border: 1px solid var(--af-border);
    border-radius: var(--af-radius);
  }

  .docs__body {
    margin: 6px 0 0;
    color: var(--af-muted);
    font-size: 15px;
  }

  .docs__guides {
    display: grid;
    gap: 6px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }

  .docs__guides a {
    color: var(--af-accent);
  }

  .docs__guides a:hover {
    text-decoration: underline;
  }

  .pq__title {
    margin: 0 0 16px;
    font-size: clamp(1.5rem, 2.8vw, 1.95rem);
  }

  .pq__list {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  .pq__item {
    max-width: 72ch;
  }

  .pq__item dt {
    color: var(--af-text);
    font-weight: 600;
  }

  .pq__item dd {
    margin: 4px 0 0;
    color: var(--af-muted);
    line-height: 1.6;
  }

  .pq__item dd a {
    color: var(--af-accent);
  }

  .docs__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pop__head {
    display: grid;
    gap: 6px;
  }

  .pop__title {
    margin: 0;
    font-size: clamp(1.5rem, 2.8vw, 1.95rem);
  }

  .pop__desc {
    margin: 0;
    color: var(--af-muted);
    font-size: 15px;
  }

  .pop__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  .pop__all {
    margin: 18px 0 0;
  }

  .pop__all a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--af-accent);
    font-weight: 600;
  }

  .pop__all a:hover {
    text-decoration: underline;
  }

  @media (max-width: 1080px) {
    .cats__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .hm__inner {
      gap: 24px;
    }

    .hm__art {
      max-width: 420px;
    }

    .nums__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .nums__list > div:nth-child(3) {
      border-inline-start: 0;
    }

    .nums__list > div:nth-child(n + 3) {
      border-block-start: 1px solid var(--af-border);
    }

    .cats__list,
    .pop__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .docs__inner {
      padding: 20px;
    }
  }

  @media (max-width: 560px) {
    .pop__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 420px) {
    .cats__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .founder-home__body {
    margin: 0 0 16px;
    max-width: 62ch;
    color: var(--af-muted);
    line-height: 1.65;
  }
</style>
