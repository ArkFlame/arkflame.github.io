---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FounderCard from "@/components/FounderCard.astro";
import { SITE } from "@/data/site";
import { PRODUCTS } from "@/data/products";
import { ORG_ID, absUrl, breadcrumb, graph, webPage } from "@/data/schema";

const description =
  "ArkFlame Studios builds Minecraft server, security, performance and gameplay software. It is built by LinsaFTW, an Argentine software developer.";

const founderPhoto = "/assets/img/founder/linsaftw";

const buildAreas = [
  {
    label: "Security",
    href: "/plugins/security/",
    body: "Exploit protection, anticheat, authentication and abuse prevention for servers and networks.",
  },
  {
    label: "Performance",
    href: "/plugins/performance/",
    body: "Optimization tools for entity load, redstone abuse, runtime stability and high-load servers.",
  },
  {
    label: "Network",
    href: "/plugins/network/",
    body: "Proxy infrastructure for networks running Velocity or Bungee-compatible proxies.",
  },
  {
    label: "Gameplay",
    href: "/plugins/gameplay/",
    body: "PvP, practice, minigame and player-facing systems for multiplayer servers.",
  },
];

const milestones = [
  "FlameCord: first public BuiltByBit release, 2020-02-01",
  "VeloFlame: first public BuiltByBit release, 2025-10-27",
  "2026-05-28: public article naming ArkFlame Studios the main hub",
  "FairPlay: first public BuiltByBit release, 2026-06-12",
];

const jsonLd = graph(
  webPage(
    "AboutPage",
    `${absUrl("/about/")}#aboutpage`,
    "About ArkFlame Studios | Minecraft Infrastructure Software",
    absUrl("/about/"),
    description,
    { mainEntity: { "@id": ORG_ID } },
  ),
  {
    "@type": "Person",
    "@id": `${absUrl("/about/")}#founder`,
    name: SITE.founderName,
    alternateName: SITE.founderHandle,
    jobTitle: "Founder & Developer",
    description: "Argentine software developer and founder of ArkFlame Studios.",
    url: SITE.founderUrl,
    image: absUrl(`${founderPhoto}-720.webp`),
    nationality: "Argentina",
    worksFor: { "@id": ORG_ID },
    sameAs: [SITE.founderUrl, SITE.builtByBitUrl],
  },
  breadcrumb(`${absUrl("/about/")}#breadcrumb`, [{ name: "About", url: absUrl("/about/") }]),
);
---

<BaseLayout
  title="About ArkFlame Studios | Minecraft Infrastructure Software"
  description={description}
  canonicalPath="/about/"
  jsonLd={jsonLd}
>
  <div class="af-container">
    <nav class="ab-crumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><span aria-current="page">About</span></li>
      </ol>
    </nav>
  </div>

  <section class="af-section ab-lead" aria-label="About ArkFlame Studios">
    <div class="af-container">
      <h1>About ArkFlame Studios</h1>
      <p class="ab-lede">
        ArkFlame Studios builds Minecraft infrastructure, security, performance,
        authentication, anticheat and gameplay software.
      </p>
      <p class="ab-copy">
        We build server and proxy software, not resource packs, shaders or client
        mods. Our products run where abuse filtering, load control and entry
        protection happen: on the server or the proxy.
      </p>
      <p class="ab-copy">
        Each product page lists its supported platforms and versions. Check
        that page before you deploy. Nothing here guarantees an environment you
        haven't tested. Minecraft is a trademark of Mojang Studios. ArkFlame
        Studios is not affiliated with Mojang or Microsoft.
      </p>
    </div>
  </section>

  <section class="af-section" aria-labelledby="ab-build-heading">
    <div class="af-container">
      <h2 id="ab-build-heading">What we build</h2>
      <ul class="ab-areas">
        {
          buildAreas.map((area) => (
            <li class="af-card ab-area">
              <a class="af-chip" href={area.href}>{area.label}</a>
              <p>{area.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="ab-copy">
        Authentication and anticheat sit under security. Proxy and ingress
        control sit under network, guarding the entry point of a whole network
        rather than a single server. Products cover legacy and modern Minecraft,
        including Paper, Folia, Velocity and BungeeCord. Our work focuses on
        packet handling, concurrency, cross-version compatibility, runtime cost
        and security boundaries.
      </p>
    </div>
  </section>

  <section class="af-section" aria-labelledby="ab-facts-heading">
    <div class="af-container">
      <h2 id="ab-facts-heading">At a glance</h2>
      <dl class="ab-facts">
        <div>
          <dt>Name</dt>
          <dd>ArkFlame Studios (ArkFlame)</dd>
        </div>
        <div>
          <dt>What</dt>
          <dd>Minecraft server plugins and proxy software for security, performance, network and SMP gameplay.</dd>
        </div>
        <div>
          <dt>Since</dt>
          <dd>ArkFlame-branded activity is documented from 2013-11-29. This site does not state a company start date.</dd>
        </div>
        <div>
          <dt>Catalogue</dt>
          <dd>{PRODUCTS.length} products listed on the plugins index.</dd>
        </div>
        <div>
          <dt>Official links</dt>
          <dd>
            <ul class="ab-links">
              <li><a href={SITE.builtByBitUrl} target="_blank" rel="noopener noreferrer">BuiltByBit creator page</a></li>
              <li><a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a></li>
              <li><a href={SITE.discordUrl} target="_blank" rel="noopener noreferrer">Discord</a></li>
              <li><a href={SITE.founderUrl} target="_blank" rel="noopener noreferrer">Founder site</a></li>
            </ul>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="af-section" aria-labelledby="ab-founder-heading">
    <div class="af-container">
      <FounderCard headingId="ab-founder-heading">
        <p class="ab-copy">
          LinsaFTW is an Argentine software developer. He designs, builds and
          releases the products listed here, and he has been coding since
          2010 by his own account. That is his personal history, not a start
          date for this company.
        </p>
        <p class="ab-copy">
          Support questions go through the public channels linked on each
          product page.
        </p>
        <a
          class="btn btn-primary"
          href={SITE.founderUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Meet LinsaFTW
        </a>
      </FounderCard>
    </div>
  </section>

  <section class="af-section" aria-labelledby="ab-roots-heading">
    <div class="af-container">
      <h2 id="ab-roots-heading">Public roots</h2>
      <p class="ab-copy">
        ArkFlame Network independently documents ArkFlame-branded Minecraft
        activity from 2013-11-29. That shows the brand's public roots, not when
        the current company started.
      </p>
      <ol class="ab-milestones">
        {milestones.map((milestone) => <li>{milestone}</li>)}
      </ol>
      <p class="ab-copy">
        BuiltByBit dates are the first public release listed on each product's
        marketplace page. They are release and publication dates, not corporate
        milestones.
      </p>
    </div>
  </section>

  <div class="af-container ab-cta">
    <a class="btn btn-primary" href="/plugins/">Browse plugins</a>
  </div>
</BaseLayout>

<style>
  .ab-crumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 22px 0 0;
    list-style: none;
    font-size: 14px;
    color: var(--af-muted);
  }

  .ab-crumb a {
    display: inline-block;
    padding-block: 8px;
    margin-block: -8px;
    color: var(--af-muted);
  }

  .ab-crumb a:hover {
    color: var(--af-accent);
  }

  .ab-lead h1 {
    margin: 8px 0 34px;
    font-size: clamp(38px, 6vw, 60px);
  }

  .ab-lede {
    margin: 0 0 18px;
    max-width: 58ch;
    font-size: clamp(19px, 2.4vw, 24px);
    line-height: 1.45;
    color: var(--af-text);
  }

  .ab-copy {
    margin: 0 0 14px;
    max-width: 62ch;
    color: var(--af-muted);
    line-height: 1.65;
  }

  .ab-copy:last-child {
    margin-bottom: 0;
  }

  .ab-areas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
    margin: 0 0 22px;
    padding: 0;
    list-style: none;
  }

  .ab-area {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .ab-area p {
    margin: 0;
    color: var(--af-muted);
    line-height: 1.6;
  }

  .ab-facts {
    display: grid;
    gap: 0;
    max-width: 72ch;
    margin: 0;
    border: 1px solid var(--af-border);
    border-radius: var(--af-radius);
    overflow: hidden;
  }

  .ab-facts > div {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 14px;
    padding: 12px 16px;
  }

  .ab-facts > div + div {
    border-block-start: 1px solid var(--af-border);
  }

  .ab-facts dt {
    color: var(--af-muted);
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ab-facts dd {
    margin: 0;
    color: var(--af-text);
    line-height: 1.55;
  }

  .ab-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ab-links a {
    color: var(--af-accent);
  }

  @media (max-width: 560px) {
    .ab-facts > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }

  .ab-milestones {
    display: grid;
    gap: 10px;
    margin: 0 0 14px;
    padding-left: 22px;
    max-width: 62ch;
    color: var(--af-muted);
    line-height: 1.6;
  }

  .ab-milestones li::marker {
    color: var(--af-accent);
    font-family: var(--font-display);
  }

  .ab-cta {
    padding-block-end: var(--af-section-y);
    text-align: center;
  }
</style>
